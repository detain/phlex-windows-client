{
  "name": "phlix-windows",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Phlix Media Server Client for Windows",
  "main": "dist/main/index.js",
  "scripts": {
    "prebuild": "node scripts/check-assets.js",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "npm run build:vite && npm run build:electron",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.main.json && node scripts/assert-preload.mjs",
    "package": "npm run build && electron-builder --win --publish never",
    "package:store": "npm run build && electron-builder --win appx",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "smoke": "playwright test tests/smoke"
  },
  "build": {
    "appId": "app.phlix.windows",
    "productName": "Phlix",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "detain",
      "repo": "phlix-windows-client"
    },
    "appx": {
      "identityName": "Phlix",
      "publisher": "CN=Phlix",
      "publisherDisplayName": "Phlix",
      "applicationId": "Phlix"
    },
    "files": [
      "dist/**",
      "build/**",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false
  },
  "dependencies": {
    "@phlix/contracts": "github:detain/phlix-contracts#v0.4.3",
    "@phlix/ui": "github:detain/phlix-ui#v0.99.1",
    "electron-log": "^5.0.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.3.9",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@eslint/js": "^9.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "^3.2.6",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.9.0",
    "concurrently": "^8.2.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "js-yaml": ">=4.3.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.2",
    "vitest": "^3.2.6",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^3.0.0",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "glob": "^13.0.6",
    "rimraf": "^6.1.3",
    "postcss": "^8.5.18",
    "fast-uri": "^3.1.4"
  }
}
